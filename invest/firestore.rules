rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 只有你本人（指定 uid）能讀寫自己的資料；其他人，包括拿到公開 apiKey 自行註冊的帳號，一律拒絕。
    // 把下面兩處 YOUR_OWN_UID 換成 Firebase Console -> Authentication -> 使用者 看到的「使用者 UID」。
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.uid == 'RVb2CFs7a1ORm417l0pZbN5KHpS2';
    }

    // 設定與狀態：單一文件，大小有上限
    match /users/{uid}/invest/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
                      && request.resource.data.json is string && request.resource.data.json.size() < 200000;
    }

    // 加倉帳本：每筆一份文件，欄位與型別受檢查，防止寫入亂資料
    match /users/{uid}/investLedger/{id} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.id == id
        && request.resource.data.kind in ['add', 'recovery']
        && request.resource.data.sym in ['QQQ', 'SMH', 'VYM', 'SCHD']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount < 1000000
        && (!('base' in request.resource.data) || (request.resource.data.base is number && request.resource.data.base > 0 && request.resource.data.base < 1000000))
        && request.resource.data.date is string && request.resource.data.date.size() == 10;
      allow delete: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
